# Настройки Deribit
DERIBIT_BASE_URL=https://deribit.com

# Список тикеров
CRYPTO_TICKERS=["btc_usd","eth_usd"]

# Интервал сбора данных в секундах (60 секунд = 1 минута)
FETCH_INTERVAL_SECONDS=60

# НАСТРОЙКИ ДЛЯ СУБД POSTGRESQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_tracker_db


# Основная строка подключения для асинхронной SQLAlchemy 2.0 (FastAPI).
# Драйвер asyncpg обязателен для неблокирующей работы с PostgreSQL.
DATABASE_URL=postgresql+asyncpg://postgres:secret_password@localhost:5432/crypto_tracker_db


CONTAINER_NAME_BASE=deribit_db
CONTAINER_NAME_APP=deribit_app